msgctxt "#30000"
msgid "General"
msgstr "General"

msgctxt "#30001"
msgid "Subtitle providers to use"
msgstr "Proveedores de subtítulos a usar"

msgctxt "#30002"
msgid "Suggest automatic translations from:"
msgstr "Sugerir traducciones automáticas de:"

msgctxt "#30003"
msgid "Extra languages for translations:"
msgid "Lenguages adicionales para traducciones:"

msgctxt "#30004"
msgid "Clean up subtitles"
msgstr "Limpiar subtítulos"

msgctxt "#30005"
msgid "Include author in search results"
msgstr "Incluir autor en resultados de búsqueda"

msgctxt "#30006"
msgid "Include downloads in search results"
msgstr "Incluir descargas en resultados de búsqueda"

msgctxt "#30007"
msgid "Maximum search results"
msgstr "Máxima cantidad de resultados de búsqueda"

msgctxt "#50000"
msgid "File System Provider"
msgstr "File System Provider"

msgctxt "#50001"
msgid "File system provider root path"
msgstr "Ruta base para proveedor de file system"

msgctxt "#40000"
msgid "Advanced"
msgstr "Avanzado"

msgctxt "430001"
msgid "Subtitle search cache TTL in minutes (0 turns it off)"
msgstr "TTL en minútos para cache de búsqueda de subtítulos (0 para desactivar)"

msgctxt "#40002"
msgid "Translations cache TTL in days (0 turns it off)"
msgstr "TTL en días para cache de traducciones (0 para desactivar)"

msgctxt "#40003"
msgid "Path to 7z executable (7-Zip decompression support)"
msgstr "Ruta a ejecutable de 7z (soporte para decompresión de 7-Zip)"

msgctxt "#40006"
msgid "Path to MKVToolNix executables folder (MKV files subtitles extraction support)"
msgstr "Ruta a directorio con ejecutables de MKVToolNix (suporte para extracción de subtítulos desde archivos MKV)"

msgctxt "#40004"
msgid "Exclude splitted subtitles from results"
msgstr "Excluir subtítulos divididos de los resultados"

msgctxt "#40005"
msgid "Cache whole requests (for debugging only, increases required cache storage size)"
msgstr "Chear request completos (sólo para debugging, incrementa el tamaño de cache en disco)"

msgctxt "#60000"
msgid "Subtitles Cleanup"
msgstr "Limpieza de Subtítulos"

msgctxt "#60001"
msgid "Remove advertisements"
msgstr "Remover publicidades"

msgctxt "#60002"
msgid "Remove hearing impaired markers"
msgstr "Remover guías para personas con discapacidad auditiva"

msgctxt "#60003"
msgid "Update rules URL"
msgstr "URL de actualización de reglas"

msgctxt "#60004"
msgid "Update rules interval in days"
msgstr "Intervalo en días para actualización de reglas"

msgctxt "#40007"
msgid "SubDivX browser session"
msgstr "Sesión del navegador para SubDivX"

msgctxt "#400071"
msgid "Cloudflare protects SubDivX from clients that are not browsers, and the clearance cookie it issues cannot be read by page scripts. With Kodi running, open http://127.0.0.1:39517/ in a browser on this same computer: copy the subdivx.com request from the developer tools (Copy as cURL) and paste it there, or paste that same text here. The value expires; repeat when SubDivX stops returning results."
msgstr "Cloudflare protege SubDivX de los clientes que no son navegadores, y las páginas no pueden leer la cookie de acceso que emite. Con Kodi abierto, abrí http://127.0.0.1:39517/ en un navegador en esta misma computadora: copiá la petición a subdivx.com desde las herramientas de desarrollo (Copiar como cURL) y pegala ahí, o pegá ese mismo texto acá. El valor caduca; repetí el proceso cuando SubDivX deje de devolver resultados."

msgctxt "#40008"
msgid "SubDL API key"
msgstr "Clave de API de SubDL"

msgctxt "#400081"
msgid "SubDL requires an API key. Sign in at https://subdl.com/panel/api to get a free one (2,000 requests a day); searches are skipped while this is empty."
msgstr "SubDL requiere una clave de API. Iniciá sesión en https://subdl.com/panel/api para obtener una gratuita (2.000 solicitudes por día); las búsquedas se omiten mientras esté vacía."

msgctxt "#40009"
msgid "OpenSubtitles.com API key"
msgstr "Clave de API de OpenSubtitles.com"

msgctxt "#400091"
msgid "Free API key from the developer page of your OpenSubtitles.com account. Required for searching this provider."
msgstr "Clave de API gratuita de la página de desarrolladores de tu cuenta de OpenSubtitles.com. Necesaria para buscar con este proveedor."

msgctxt "#40010"
msgid "OpenSubtitles.com username"
msgstr "Usuario de OpenSubtitles.com"

msgctxt "#400101"
msgid "Your OpenSubtitles.com account username. Downloads need a login, because the API hands out file links only to authenticated users."
msgstr "El nombre de usuario de tu cuenta de OpenSubtitles.com. Las descargas requieren iniciar sesión, porque la API solo entrega enlaces a usuarios autenticados."

msgctxt "#40011"
msgid "OpenSubtitles.com password"
msgstr "Contraseña de OpenSubtitles.com"

msgctxt "#400111"
msgid "Password for that account, stored in Kodi's settings. Downloads consume the account's daily quota."
msgstr "Contraseña de esa cuenta, guardada en la configuración de Kodi. Las descargas consumen la cuota diaria de la cuenta."
